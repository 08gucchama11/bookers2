<h1>Log in</h1>
<%= form_with url: session_path, method: :post do |f| %>
  <div class="field">
    <%= f.label :name, "Name" %><br>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :password, "Password" %><br>
    <%= f.password_field :password %>
  </div>

  <div class="actions">
    <%= f.submit "Log in" %>
  </div>
<% end %>

<br>
<%= link_to "Sign up", sign_up_path %>
