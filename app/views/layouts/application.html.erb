<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bookers2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://kit.fontawesome.com/166dc20c52.js" crossorigin="anonymous"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="bg-dark">
      <% if authenticated? %>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
          <div class="container-fluid mx-5">
            <%= link_to "Bookers", root_path, class: "navbar-brand text-light" %>
            <div class="navbar-nav ms-auto">
              <%= link_to user_path(Current.user), class: "nav-link text-light" do %>
                <i class="fa-solid fa-house"></i> Home
              <% end %>
              <%= link_to users_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-users"></i> Users
              <% end %>
              <%= link_to books_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-book-open"></i> Books
              <% end %>
              <%= link_to sign_out_path, data: { turbo_method: :delete }, class: "nav-link text-light" do %>
                <i class="fa-solid fa-right-from-bracket"></i> Log out
              <% end %>

            </div>
          </div>
        </nav>
      <% else %>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
          <div class="container-fluid mx-5">
            <%= link_to "Bookers", root_path, class: "navbar-brand text-light" %>
            <div class="navbar-nav ms-auto">
              <%= link_to root_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-house"></i> Home
              <% end %>
              <%= link_to home_about_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-link"></i> About
              <% end %>
              <%= link_to sign_up_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-user-plus"></i> Sign up
              <% end %>
              <%= link_to sign_in_path, class: "nav-link text-light" do %>
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Log in
              <% end %>
            </div>
          </div>
        </nav>
      <% end %>
    </header>
    <div class="flash-message">
      <% flash.each do |key, value| %>
        <div class="alert alert-<%= key %>">
          <%= value %>
        </div>
      <% end %>
    </div>
    <%= yield %>
    <footer>
      <div class="container text-center">
        CopyRight Infratop.inc
      </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  </body>
</html>
