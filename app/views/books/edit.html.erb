<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-6">

      <h1> Editing Book</h1>

      <div class="mt-3">
        <%= form_with model: @book, local: true do |f| %>

        <div class="mb-4">
          <%= f.label :title, "Title", class: "form-label fw-bold" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= f.label :image, "Image", class: "form-label fw-bold" %>
          <%= f.file_field :image, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= f.label :body, "Opinion", class: "form-label fw-bold" %>
          <%= f.text_area :body, class: "form-control", rows: 5 %>
        </div>

        <div class="mt-4">
          <%= f.submit "Update Book", class: "btn btn-success" %>
        </div>

        <% end %>
      </div>

    </div>
  </div>
</div>
