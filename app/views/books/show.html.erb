<% if @book.errors.any? %>
  <%= @book.errors.count %>errors prohibited this obj from being saved:
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
<% end %>

<div class="container">
  <div class="row">
    <div class="col-md-3">
      <%= render 'users/userinfo', user: @user %>
      <%= render "books/new", book: @book %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h1>Book detail</h1>

      <table class="table border-top">
        <tbody>
          <tr>
            <td>
              <%= image_tag @book.get_profile_image, size: "80x80" %><br>
              <%= link_to @book.user.name, user_path(@book.user) %>
            </td>
            <td>
              <%= link_to @book.title, book_path(@book) %>
            </td>
            <td>
              <%= @book.body %>
            </td>
            <% if @book.user == Current.user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book), class: "btn btn-success mb-2" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(@book), method: :delete, data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" }, class: "btn btn-danger" %>

              </td>
            <% end %>
          </tr>
        </tbody>
      </table>

    </div>
  </div>
</div>