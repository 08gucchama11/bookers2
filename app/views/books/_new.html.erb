<% if book.errors.any? %>
  <div class="alert alert-danger">
    <strong>Book error:</strong>
    <ul>
      <% book.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<h2>New book</h2>

<%= form_with model: Book.new, url: books_path, local: true do |f| %>

  <div class="form-group">
    <label>Title</label>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Opinion</label>
    <%= f.text_area :body, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Picture</label>
    <%= f.file_field :image, accept: "image/*", class: "form-control" %>
  </div>

  <%= f.submit "Create Book", class: "btn btn-primary mt-3" %>

<% end %>
