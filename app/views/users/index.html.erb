<div class="container">
  <div class="row">
    <div class="col-4">
      <%= render "users/userinfo", user: @user %>
      <%= render "books/new", book: @book %>
    </div>
    <div class="col-8">
      <h1>Users</h1>
      <table class="table border-top">
        <thead>
          <tr>
            <th>image</th>
            <th colspan=2>name</th>
            </tr>
        </thead>
        <tbody>
           <% @users.each do |user| %>
             <tr>
               <td>
                 <%= image_tag user.get_profile_image, size: "80x80" %>
               </td>
               <td>
                 <%= user.name %>
               </td>
               <td>
                 <%= link_to "Show", user_path(user), class: "btn btn-primary" %>
               </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>