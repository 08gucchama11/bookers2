<div class="container">
  <div class="row">
    <div class="col-4">
      <%= render "userinfo", user: @user %>
      <%= render "books/new", book: @book %>
    </div>
    <div class="col-8">
      <h1>Book detail</h1>
      <table class="table border-top">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>
        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td><%= image_tag book.get_image, size: "80x80" %></td>
              <td><%= book.title %></td>
              <td><%= book.body %></td>
              <td>
                <%= link_to "Edit", edit_book_path(book), class: "btn btn-sm btn-success" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(book), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>