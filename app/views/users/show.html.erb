<div class="container">
  <div class="row">
    <div class="col-4">
      <%= render "userinfo", user: @user %>
      <%= render "books/new", book: @book %>
    </div>
    <div class="col-8">
      <h1>Books</h1>
      <table class="table border-top table-hover">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>
        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td><%= image_tag book.get_image, size: "80x80" %></td>
              <td><%= link_to book.title, book_path(book) %></td>
              <td><%= book.body %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>