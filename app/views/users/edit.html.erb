<% if @user.errors.any? %>
  <div class="alert alert-danger">
    <strong>Validation error:</strong>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li>Error: <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-3">
  <div class="row justify-content-center">
    <div class="col-6">

      <h1>User info</h1>

      <% if @user.errors.any? %>
        <%= @user.errors.count %>errors prohibited this obj from being saved:
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

        <%= form_with model: @user, local: true do |f| %>

        <div class="mb-4">
          <%= f.label :name, "Name" %><br>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-4">
          <%= f.label :profile_image, "Image" %><br>
          <%= f.file_field :profile_image, class: "form-control" %>

        </div>

        <div class="mb-4">
          <%= f.label :introduction, "Introduction" %><br>
          <%= f.text_area :introduction, class: "form-control" %>
      </div>

        <div class="mt-4">
          <%= f.submit "Update User", class: "btn btn-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>